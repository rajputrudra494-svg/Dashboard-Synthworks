# =============================================================================
#  SynthWorks — environment template
#
#  Copy this file to `.env` and fill in the values from your Supabase project:
#      Supabase Dashboard → your project → Settings → API
#
#  IMPORTANT — how this file is actually used
#  ------------------------------------------
#  SynthWorks is a no-build static app. Browsers cannot read a .env file, so
#  nothing here is loaded automatically. You have two options:
#
#    1. LOCAL / SIMPLE (recommended to start)
#       Paste the two values directly into `supabase.js`, where the
#       file says YOUR_SUPABASE_URL and YOUR_SUPABASE_ANON_KEY.
#
#    2. CI / VERCEL / NETLIFY
#       Set these as environment variables on the host and generate a small
#       `env.js` at build time that defines window.__SYNTHWORKS_ENV__.
#       supabase.js already prefers that object over its own constants.
#       The README ("Environment variables") has a ready-made build command.
#
#  Safe to commit?  This EXAMPLE file yes. Your real `.env` — no. It is listed
#  in .gitignore.
# =============================================================================


# ── Required ─────────────────────────────────────────────────────────────────

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# The "anon / public" key — NOT the service_role key.
#
# This key is designed to be shipped to browsers. It is safe here *because*
# Row Level Security (setup.sql) is what actually protects your
# data. If RLS is off, this key can read everything — so never disable it.
SUPABASE_ANON_KEY=


# ── Never put these in a front-end build ─────────────────────────────────────
#
# SUPABASE_SERVICE_ROLE_KEY=...
#   Bypasses every RLS policy. It belongs only in a server, an Edge Function
#   or a CI secret — never in anything the browser can download.
#
# SUPABASE_DB_URL=postgresql://...
#   Direct Postgres connection string, for migrations from your machine.


# ── Optional: defaults for a fresh workspace ─────────────────────────────────
# These are conveniences for seeding, not runtime configuration. The live
# values live in the `settings` table and are editable from Settings →
# Workspace by anyone on the team.

COMPANY_NAME=SynthWorks
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
